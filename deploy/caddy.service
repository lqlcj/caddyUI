[Unit]
Description=Caddy —— 反向代理数据面（由 Relay 面板下发配置）
Documentation=https://caddyserver.com/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy

# --resume 是「一直都能用」的关键：Caddy 会优先加载上次自动保存的配置
# （autosave.json）。也就是说，哪怕面板挂了、数据库删了、机器重启了，
# 反代也能靠自己恢复到最后一次生效的状态。
# 只有在从来没有下发过任何配置时，才会回退到 bootstrap.Caddyfile。
ExecStart=/usr/bin/caddy run --resume --config /etc/caddy/bootstrap.Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/caddy/bootstrap.Caddyfile --force

# 崩了自己爬起来
Restart=always
RestartSec=3s
TimeoutStopSec=15s

# 小内存机上给 Go 的 GC 上个紧箍咒。实测这一条能把常驻内存压掉一大半，
# 不加的话 Go 不着急把回收的内存还给系统。
Environment=GOMEMLIMIT=64MiB
Environment=GOGC=50

# 允许非 root 绑定 80/443
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# /run/caddy，admin socket 放这里
RuntimeDirectory=caddy
RuntimeDirectoryMode=0750

# 证书和 ACME 账户密钥存这里 —— 备份时千万别漏了它
StateDirectory=caddy
StateDirectoryMode=0700

LimitNOFILE=1048576
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
